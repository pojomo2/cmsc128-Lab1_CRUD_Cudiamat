<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TodoApp.Views.ConfirmDialog"
        Title="Confirm"
        Width="300" Height="130"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

        <StackPanel Margin="20" Spacing="15">
            <TextBlock x:Name="MessageText" Text="Are you sure you want to delete this task?" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yes" Width="75" Margin="0,0,10,0" Click="YesButton_Click"/>
                <Button Content="No" Width="75" Click="NoButton_Click"/>
            </StackPanel>
        </StackPanel>
</Window>