<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:TodoApp.Converters"
        xmlns:views="using:TodoApp.Views"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TodoApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TodoApp">
    <Window.Resources>
        <conv:StrikethroughConverter x:Key="StrikethroughConverter"/>
            
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- List selector and list creation -->
        <StackPanel Grid.Row="0"
                    IsVisible="{Binding IsTasksVisible}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="10,10,10,4">
            <ComboBox Width="220"
                    ItemsSource="{Binding ListChoices}"
                    SelectedItem="{Binding SelectedList}"
                    PlaceholderText="Choose a list">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Width="180"
                    Text="{Binding NewListName}"
                    Watermark="New list name"/>

            <Button Content="Create list"
                    Command="{Binding CreateListCommand}"/>
        </StackPanel>

        <!-- Add members to the selected list -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsListManagementVisible}"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="10,4">
            <TextBox Width="220"
                    Text="{Binding MemberEmail}"
                    Watermark="Member email"/>

            <Button Content="Add member"
                    Command="{Binding AddMemberCommand}"/>

            <TextBlock Text="{Binding ListMessage}"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Auth view: assumes an AuthView data template exists in the app -->
        <TransitioningContentControl Grid.Row="2"
            Content="{Binding Auth}"
            IsVisible="{Binding Auth.CurrentUser,
                Converter={x:Static converters:ObjectConverters.IsNull}}"/>

        <views:ProfileView Grid.Row="2"
            DataContext="{Binding}"
            IsVisible="{Binding IsProfileOpen}"/>

        <!-- Task entry and task list -->
        <DockPanel Grid.Row="2"
                Margin="10"
                IsVisible="{Binding IsTasksVisible}">
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,8">
                <TextBox Width="200"
                        Text="{Binding NewTitle}"
                        Watermark="Task title"/>

                <DatePicker SelectedDate="{Binding NewDueDate}"/>

                <ComboBox Width="100"
                        ItemsSource="{Binding PriorityOptions}"
                        SelectedItem="{Binding NewPriority}"/>

                <ComboBox Width="120"
                        ItemsSource="{Binding TagOptions}"
                        SelectedItem="{Binding NewTag}"/>

                <Button Content="Add task"
                        Command="{Binding AddTaskCommand}"/>

                <Button Content="Save edits"
                        Command="{Binding SaveEditsCommand}"/>
                <Button Content="Log out"
                        Command="{Binding Auth.LogoutCommand}"/>
                <Button Content="Profile"
                        Command="{Binding ShowProfileCommand}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding IsUndoBannerVisible}">
                <TextBlock Text="Task deleted"
                        VerticalAlignment="Center"/>
                <Button Content="Undo"
                        Command="{Binding UndoCommand}"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Tasks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsDone}"
                                    Content="{Binding Title}"
                                    Command="{Binding $parent[Window].DataContext.ToggleDoneCommand}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Edit"
                                    Command="{Binding $parent[Window].DataContext.EditTaskCommand}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Delete"
                                    Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
