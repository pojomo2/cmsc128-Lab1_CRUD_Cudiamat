<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TodoApp.Views.AuthView">

    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="Create account" FontSize="24" />

        <TextBox Watermark="Email" Text="{Binding RegEmail}" />
        <TextBox Watermark="Display name" Text="{Binding RegDisplayName}" />
        <TextBox Watermark="Password" PasswordChar="●" Text="{Binding RegPassword}" />

        <Button Content="Register" Command="{Binding RegisterCommand}" />
        <TextBlock Text="{Binding RegisterError}" />
    </StackPanel>
</UserControl>